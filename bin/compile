#!/usr/bin/env bash
# usage: bin/compile <build_dir> <cache_dir> <env_dir>

source "$( readlink -f "$( dirname "${0}" )/../vendor/cmnlib.sh" )"

# -----------------------------------------------------------------------------

# Global regex used to parse the `.buildpacks` file.
# Putting it as a global allows it to be compiled once.
#
# It's made of:
#
# ^[[:space:]]*
#   Ignores space-like chars at the beginning of the line.
#
# ([^#[:space:]][^#]*)
#   Captures the URL.
#   Captures anything that doesn't start with '#' or a space-like chars until a
#   potential '#' (excluded).
#
# (#(.*))?
#   Captures an optional branch name.
#   Group 2 is '#branch_name'
#   Group 3 is 'branch_name'
#
# [[:space:]]*$
#   Ignores space-like chars at the end of the line.
#

readonly PARSE_LINE_REGEX='^[[:space:]]*([^#[:space:]][^#]*)(#(.*))?[[:space:]]*$'

multi::url::parse() {
#
# Parse the given line and retrieve a URL and a branch name, if given.
# This function is designed to parse the lines of the `.buildpacks` file.
#
# Usage:
#   ```bash
#   while IFS= read -r line; do
#       multi::url::parse "${line}" url branch
#       # do something with $url and $branch
#       # echo "URL=${url} BRANCH=${branch}"
#   done < "${buildpacks_file}"
#   ```
#

	local line="${1}"

	# Makes _url a reference to the variable named by $2's value:
	local -n _url="${2}"
	# Makes _branch a reference to the variable named by $3's value:
	local -n _branch="${3}"

	# If the result of the Bash expansion is empty,
	# then the line contains only space-like chars.
	# We can ignore it.
	[[ -z "${line//[[:space:]]/}" ]] \
		&& {
			return 1
		}

	# If the line matches the regex, then it's a comment.
	# We can ignore it.
	[[ "${line}" =~ ^[[:space:]]*# ]] \
		&& {
			return 1
		}

	# Extracts the URL and the branch name out of the line, using the regex:
	if [[ "${line}" =~ $PARSE_LINE_REGEX ]]; then
		_url="${BASH_REMATCH[1]}"
		_branch="${BASH_REMATCH[3]}"

		return 0
	fi

	return 1
}

# -----------------------------------------------------------------------------

cmn::main::start "${0}" "${1}" "${2}" "${3}"

# -----------------------------------------------------------------------------

#FIXME:
# unset GIT_DIR

readonly buildpacks_file="${build_dir:?}/.buildpacks"

while IFS= read -r line; do
	url=""
	branch=""

	# Skip the line if it is empty, commented out, or if it doesn't match what
	# we are waiting for:
	multi::url::parse "${line}" url branch || continue

	cmn::output::debug <<- EOM
		Considering:
		  url:    ${url}
		  branch: ${branch:-"<none>"}
	EOM

	cmn::step::start "Processing buildpack: ${url}${branch:+"#$branch"}"

	cmn::bp::run "${build_dir:?}" "${cache_dir:?}" "${env_dir:?}" \
		"${tmp_dir:?}" "${url}" "${branch}"

done < "${buildpacks_file}"


if [[ -e "${build_dir:?}/last_pack_release.out" ]]; then
	cmn::output::info <<-EOM
		Using release configuration from last buildpack (${technology}).
	EOM
fi

cmn::main::finish
